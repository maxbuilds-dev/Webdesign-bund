# Echte HTTP-Kopfzeilen fuer Netlify.
#
# Auf GitHub Pages war die Content Security Policy nur als <meta http-equiv>
# moeglich. Netlify liefert sie hier zusaetzlich als echte Kopfzeile. Beides
# gilt gleichzeitig, der Browser wendet die strengere Fassung an. Die Regeln
# unten ueberschneiden sich deshalb absichtlich nicht: pro Seite genau eine
# Policy, wortgleich mit dem meta-Tag in der jeweiligen Datei.
#
# Wird eine Policy im HTML geaendert, muss sie hier mitgeaendert werden.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Startseite. Sendet das Kontaktformular an Web3Forms, deshalb connect-src
# und form-action. frame-ancestors gibt es nur als Kopfzeile, im meta-Tag
# wird die Anweisung ignoriert.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src https://api.web3forms.com; base-uri 'none'; form-action https://api.web3forms.com; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src https://api.web3forms.com; base-uri 'none'; form-action https://api.web3forms.com; frame-ancestors 'none'

# Rechtstexte und Fehlerseite: kein Formular, kein Skriptziel nach aussen.
/impressum.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/datenschutz.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/404.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
